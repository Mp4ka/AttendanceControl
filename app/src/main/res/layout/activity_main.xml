<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/tvAppTitle"
            style="@style/AppTitle"
            android:text="@string/app_name" />

        <TextView
            android:id="@+id/tvAppSubtitle"
            style="@style/AppSubtitle"
            android:text="@string/main_subtitle" />

        <TextView
            style="@style/SectionLabel"
            android:text="@string/main_section_actions" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStudents"
            style="@style/MenuCard"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/stroke"
            app:strokeWidth="1dp">

            <LinearLayout style="@style/MenuCardBody">

                <TextView
                    style="@style/MenuCardTitle"
                    android:text="@string/menu_students" />

                <TextView
                    style="@style/MenuCardHint"
                    android:text="@string/menu_students_hint" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAttendance"
            style="@style/MenuCard"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/stroke"
            app:strokeWidth="1dp">

            <LinearLayout style="@style/MenuCardBody">

                <TextView
                    style="@style/MenuCardTitle"
                    android:text="@string/menu_attendance" />

                <TextView
                    style="@style/MenuCardHint"
                    android:text="@string/menu_attendance_hint" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStatistics"
            style="@style/MenuCard"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/stroke"
            app:strokeWidth="1dp">

            <LinearLayout style="@style/MenuCardBody">

                <TextView
                    style="@style/MenuCardTitle"
                    android:text="@string/menu_statistics" />

                <TextView
                    style="@style/MenuCardHint"
                    android:text="@string/menu_statistics_hint" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvVersion"
            style="@style/FooterText"
            android:text="@string/main_footer" />

    </LinearLayout>
</ScrollView>
